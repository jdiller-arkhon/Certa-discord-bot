{
  "name": "arkhon-discord-bots",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b bots/certa",
    "typecheck": "tsc -b bots/certa packages/shared/tsconfig.test.json bots/certa/tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "certa:dev": "pnpm --filter @arkhon/certa-bot dev",
    "certa:register": "pnpm --filter @arkhon/certa-bot register"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
