# Copy to .env and fill in. Blank values fall back to defaults.

# ---------------------------------------------------------------------------
# Shared Discord settings
# ---------------------------------------------------------------------------
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Certa bot (bots/certa)
# ---------------------------------------------------------------------------
# Bot token and application ID from https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Optional: register commands to one guild for instant updates (recommended in dev).
DISCORD_GUILD_ID=

# Certa backend: "http" for the real API, "mock" to run entirely off the local database.
CERTA_CLIENT=mock
# Required when CERTA_CLIENT=http
CERTA_API_BASE_URL=https://arkhonindustries.com/certa/api
CERTA_API_TOKEN=

# SQLite file for links, reminder history, and (in mock mode) mock Certa data.
CERTA_DB_PATH=./data/certa.sqlite
# IANA time zone for "today", daily jobs, and the monthly leaderboard.
CERTA_TIMEZONE=America/Denver

# Channel IDs (right-click a channel > Copy Channel ID). Leave blank to disable the feature.
CERTA_FLIGHT_LOGS_CHANNEL_ID=
CERTA_PREFLIGHT_CHANNEL_ID=
CERTA_PILOT_LOUNGE_CHANNEL_ID=

# Local times (HH:mm, 24-hour) in CERTA_TIMEZONE.
CERTA_REMINDER_TIME=09:00
CERTA_PREFLIGHT_TIME=06:30
CERTA_LEADERBOARD_TIME=09:00
# Comma-separated ICAO codes for the daily #preflight post.
CERTA_PREFLIGHT_AIRPORTS=KDEN,KBJC,KAPA

# Preflight go/caution thresholds. CAUTION when wind or gusts exceed, or
# visibility or ceiling fall below, these values, or when Kp >= PREFLIGHT_KP_CAUTION.
PREFLIGHT_MAX_WIND_KT=15
PREFLIGHT_MAX_GUST_KT=20
PREFLIGHT_MIN_VISIBILITY_SM=3
PREFLIGHT_MIN_CEILING_FT=1000
PREFLIGHT_KP_CAUTION=5
# TFRs within this distance of the airport are listed.
PREFLIGHT_TFR_RADIUS_NM=30

# ---------------------------------------------------------------------------
# Database backup (optional). Where the disk isn't kept across restarts (Cloudflare
# Containers), Litestream replicates the SQLite file to S3-compatible storage and
# restores it on start. Leave LITESTREAM_BUCKET blank to turn it off.
# ---------------------------------------------------------------------------
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
